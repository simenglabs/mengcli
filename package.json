    "darwin",
    "linux"
  ],
  "keywords": [
    "ai",
    "agent",
    "cli",
    "multi-agent",
    "tmux",
    "autonomous",
    "coding-agent",
    "llm"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/menglabs/mengcli.git"
  },
  "homepage": "https://github.com/menglabs/mengcli#readme",
  "bugs": {
    "url": "https://github.com/menglabs/mengcli/issues"
  },
