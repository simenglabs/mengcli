{
  "name": "mengcli",
  "version": "1.0.0",
  "description": "Autonomous AI multi-agent coding CLI: describe the work, get back a git branch",
  "type": "module",
  "bin": {
    "mengcli": "bin/mengcli.cjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "README.md"
  ],
  "scripts": {
    "dev": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun test && tsc --noEmit"
  },
  "dependencies": {
    "bun": "^1.3.0",
    "zod": "^4.4.3"
  },
  "engines": {
